
public class Funcionario {
    private String nome;
    private double salarioMensal;
    private final boolean pj;

    public Funcionario(String nome, double salarioMensal) {
        this(nome, salarioMensal, false);
    }

    protected Funcionario(String nome, double salarioMensal, boolean pj) {
        if (nome == null || nome.isBlank()) {
            throw new IllegalArgumentException("O nome deve ser preenchido.");
        }
        if (salarioMensal < 0) {
            throw new IllegalArgumentException("O salário não pode ser negativo.");
        }
        this.nome = nome;
        this.salarioMensal = salarioMensal;
        this.pj = pj;
    }

    public String getNome() {
        return nome;
    }

    public double getSalarioMensal() {
        return salarioMensal;
    }

    public boolean isPJ() {
        return pj;
    }

    protected double arredondar(double valor) {
        return Math.round(valor * 100.0) / 100.0;
    }

    public double calcularBruto() {
        return salarioMensal;
    }

    public double calcularINSS() {
        if (isPJ()) {
            return 0;
        }
        double bruto = calcularBruto();
        double inss;

        if (bruto <= 1621.00) {
            inss = bruto * 0.075;
        } else if (bruto <= 2902.84) {
            inss = 1621.00 * 0.075 + (bruto - 1621.00) * 0.09;
        } else if (bruto <= 4354.27) {
            inss = 1621.00 * 0.075 + 1281.84 * 0.09
                    + (bruto - 2902.84) * 0.12;
        } else {
            double base = bruto;
            if (base > 8475.55) {
                base = 8475.55;
            }
            inss = 1621.00 * 0.075 + 1281.84 * 0.09
                    + 1451.43 * 0.12 + (base - 4354.27) * 0.14;
        }
        return arredondar(inss);
    }

    public double calcularIRRF() {
        if (isPJ()) {
            return 0;
        }
        double bruto = calcularBruto();
        double deducao = calcularINSS();
        if (deducao < 607.20) {
            deducao = 607.20;
        }
        double base = bruto - deducao;
        if (base < 0) {
            base = 0;
        }

        double imposto;
        if (base <= 2428.80) {
            imposto = 0;
        } else if (base <= 2826.65) {
            imposto = base * 0.075 - 182.16;
        } else if (base <= 3751.05) {
            imposto = base * 0.15 - 394.16;
        } else if (base <= 4664.68) {
            imposto = base * 0.225 - 675.49;
        } else {
            imposto = base * 0.275 - 908.73;
        }
        if (imposto < 0) {
            imposto = 0;
        }
        imposto = arredondar(imposto);

        double reducao = 0;
        if (bruto <= 5000.00) {
            reducao = imposto;
        } else if (bruto <= 7350.00) {
            reducao = 978.62 - 0.133145 * bruto;
            if (reducao < 0) {
                reducao = 0;
            }
        }
        reducao = arredondar(reducao);
        double irFinal = imposto - reducao;
        if (irFinal < 0) {
            irFinal = 0;
        }
        return arredondar(irFinal);
    }

    public double calcularFGTS() {
        if (isPJ()) {
            return 0;
        }
        return arredondar(calcularBruto() * 0.08);
    }

    public double calcularMEI() {
        if (isPJ()) {
            return arredondar(86.05);
        }
        return 0;
    }

    public double calcularLiquido() {
        return arredondar(calcularBruto() - calcularINSS()
                - calcularIRRF() - calcularMEI());
    }
}

public class FuncionarioPJ extends Funcionario {
    private double valorHora;
    private double horasTrabalhadas;

    public FuncionarioPJ(String nome, double valorHora, double horasTrabalhadas) {
        this(nome, valorHora, horasTrabalhadas, true);
    }

    protected FuncionarioPJ(String nome, double valorHora,
                            double horasTrabalhadas, boolean pj) {
        super(nome, 0.0, pj);
        if (valorHora < 0) {
            throw new IllegalArgumentException("O valor da hora não pode ser negativo.");
        }
        if (horasTrabalhadas < 0) {
            throw new IllegalArgumentException("A quantidade de horas não pode ser negativa.");
        }
        this.valorHora = valorHora;
        this.horasTrabalhadas = horasTrabalhadas;
    }

    public double getValorHora() {
        return valorHora;
    }

    public double getHorasTrabalhadas() {
        return horasTrabalhadas;
    }

    @Override
    public double calcularBruto() {
        return valorHora * horasTrabalhadas;
    }
}

